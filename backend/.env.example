# Database Configuration
# For local development: sqlite+aiosqlite:///./edubridge.db
# For production (Render): Use the Internal Database URL from Render PostgreSQL
DATABASE_URL=sqlite+aiosqlite:///./edubridge.db

# Security
# Generate with: openssl rand -hex 32
SECRET_KEY=edubridge-ai-super-secret-key-change-this-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# AI Services
GEMINI_API_KEY=your-gemini-api-key-here

# VAPI (Voice AI - Optional)
VAPI_API_KEY=your-vapi-api-key
VAPI_PHONE_NUMBER_ID=your-phone-number-id
VAPI_WEBHOOK_URL=your-webhook-url

# CORS (Comma-separated list of allowed origins)
# Update with your production frontend URL after deployment
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Server Configuration (Render will set this automatically)
PORT=8000
